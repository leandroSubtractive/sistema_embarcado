<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foregroundTint="#0A0A0C"
    tools:context=".ui.EqualizerActivity">

    <!-- Back Button -->

    <!-- Application Name -->

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="65dp"
        android:layout_height="63dp"
        android:layout_marginStart="30dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/back"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintBottom_toTopOf="@+id/containerBand5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.546"
        app:layout_constraintStart_toEndOf="@+id/textView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.194"
        app:tint="?attr/colorControlNormal" />

    <!-- Selected profile name -->

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="8dp"
        android:text="@string/app_name"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/profileSelected"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/profileSelected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/default_profile"
        android:textSize="26sp"
        app:layout_constraintBottom_toTopOf="@+id/switchEqualizer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <!-- Equalizer on/off button -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchEqualizer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="50dp"
        android:layout_marginBottom="22dp"
        android:checked="true"
        android:text="@string/active_equalizer"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/containerBand1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.063"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profileSelected" />

    <!-- Volume Control -->
    <LinearLayout
        android:id="@+id/containerBand6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/containerBand1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1">

        <!-- Volume in percent -->
        <TextView
            android:id="@+id/textViewVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/default_volume_value"
            android:textColor="@color/material_dynamic_neutral50"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Vertical SeekBar -->
        <com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBarWrapper
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_gravity="center">

            <com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBar
                android:id="@+id/seekBarVolume"
                style="@android:style/Widget.DeviceDefault.SeekBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:max="100"
                android:min="0"
                android:progress="70"
                android:splitTrack="false"
                app:seekBarRotation="CW270" />
        </com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBarWrapper>

        <!-- Volume -->
        <TextView
            android:id="@+id/textViewVolumeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/volume_name"
            android:textSize="24sp"
            android:layout_gravity="center"/>
    </LinearLayout>

    <!-- Frequency band 1 -->
    <LinearLayout
        android:id="@+id/containerBand1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintStart_toEndOf="@id/containerBand6"
        app:layout_constraintEnd_toStartOf="@id/containerBand2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1">

        <!-- Gain in dB -->
        <TextView
            android:id="@+id/GainBand1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/_0_db"
            android:textColor="@color/material_dynamic_neutral50"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Vertical SeekBar -->
        <com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBarWrapper
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_gravity="center">

            <com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBar
                android:id="@+id/seekBarBand1"
                style="@android:style/Widget.DeviceDefault.SeekBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:max="15"
                android:min="-15"
                android:progress="0"
                android:splitTrack="false"
                app:seekBarRotation="CW270" />
        </com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBarWrapper>

        <!-- Frequency -->
        <TextView
            android:id="@+id/labelFreqBand1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frequencyFirstBand"
            android:textSize="24sp"
            android:layout_gravity="center"/>
    </LinearLayout>

    <!-- Frequency band 2 -->
    <LinearLayout
        android:id="@+id/containerBand2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintStart_toEndOf="@id/containerBand1"
        app:layout_constraintEnd_toStartOf="@id/containerBand3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1">

        <TextView
            android:id="@+id/GainBand2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_0_db"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/material_dynamic_neutral50"
            android:layout_gravity="center"/>

        <com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBarWrapper
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_gravity="center">

            <com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBar
                android:id="@+id/seekBarBand2"
                style="@android:style/Widget.DeviceDefault.SeekBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:max="15"
                android:min="-15"
                android:progress="0"
                android:splitTrack="false"
                app:seekBarRotation="CW270"/>
        </com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBarWrapper>

        <TextView
            android:id="@+id/labelFreqBand2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frequencySecondBand"
            android:textSize="24sp"
            android:layout_gravity="center"/>
    </LinearLayout>

    <!-- Frequency band 3 -->
    <LinearLayout
        android:id="@+id/containerBand3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintStart_toEndOf="@id/containerBand2"
        app:layout_constraintEnd_toStartOf="@id/containerBand4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1">

        <TextView
            android:id="@+id/GainBand3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_0_db"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/material_dynamic_neutral50"
            android:layout_gravity="center"/>

        <com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBarWrapper
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_gravity="center">

            <com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBar
                android:id="@+id/seekBarBand3"
                style="@android:style/Widget.DeviceDefault.SeekBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:max="15"
                android:min="-15"
                android:progress="0"
                android:splitTrack="false"
                app:seekBarRotation="CW270"/>
        </com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBarWrapper>

        <TextView
            android:id="@+id/labelFreqBand3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frequencyThirdBand"
            android:textSize="24sp"
            android:layout_gravity="center"/>
    </LinearLayout>

    <!-- Frequency band 4 -->
    <LinearLayout
        android:id="@+id/containerBand4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintStart_toEndOf="@id/containerBand3"
        app:layout_constraintEnd_toStartOf="@id/containerBand5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1">

        <TextView
            android:id="@+id/GainBand4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_0_db"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/material_dynamic_neutral50"
            android:layout_gravity="center"/>

        <com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBarWrapper
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_gravity="center">

            <com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBar
                android:id="@+id/seekBarBand4"
                style="@android:style/Widget.DeviceDefault.SeekBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:max="15"
                android:min="-15"
                android:progress="0"
                android:splitTrack="false"
                app:seekBarRotation="CW270"/>
        </com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBarWrapper>

        <TextView
            android:id="@+id/labelFreqBand4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frequencyFourthBand"
            android:textSize="24sp"
            android:layout_gravity="center"/>
    </LinearLayout>

    <!-- Frequency band 5 -->
    <LinearLayout
        android:id="@+id/containerBand5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/containerBand4"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/GainBand5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/_0_db"
            android:textColor="@color/material_dynamic_neutral50"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBarWrapper
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_gravity="center">

            <com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBar
                android:id="@+id/seekBarBand5"
                style="@android:style/Widget.DeviceDefault.SeekBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:max="15"
                android:min="-15"
                android:progress="0"
                android:splitTrack="false"
                app:seekBarRotation="CW270" />
        </com.h6ah4i.android.widget.verticalseekbar.VerticalSeekBarWrapper>

        <TextView
            android:id="@+id/labelFreqBand5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/frequencyFifthBand"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- Section with all buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/save"
        android:layout_width="104dp"
        android:layout_height="0dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="32dp"
        android:enabled="false"
        android:text="@string/save_button"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/reset"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/containerBand6" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/newProfile"
        android:layout_width="100dp"
        android:layout_height="0dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="32dp"
        android:enabled="true"
        android:text="@string/new_profile_button"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/reset"
        app:layout_constraintTop_toBottomOf="@+id/containerBand4" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reset"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="50dp"
        android:layout_marginBottom="32dp"
        android:enabled="false"
        android:text="@string/reset_button"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/newProfile"
        app:layout_constraintStart_toEndOf="@+id/save"
        app:layout_constraintTop_toBottomOf="@+id/containerBand2" />


</androidx.constraintlayout.widget.ConstraintLayout>